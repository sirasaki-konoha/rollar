// Native Zig compiler implementation.  Its optimization type, source format,
// command shape, and output policy intentionally differ from the C libraries.
library "zig" {
    compiler zig {
        flags: Vec<String>,
        output: String,
        zig_available: bool,
        file_location: String,
        objects: Vec<String>,
        optimize: String,
        failure: bool,
    }

    function name() -> String {
        return "zig";
    }

    function get_compiler(compiler: Compiler) -> CompilerStatus {
        if sys::cmd::is_exists("zig") {
            compiler = self::zig;
            compiler.file_location = sys::cmd::which("zig");
            compiler.zig_available = true;
            return Compiler::AVAILABLE;
        }
        log::error("Zig not found");
        return Compiler::NOTFOUND;
    }

    function version() -> String {
        let result = sys::process::output("zig", ["version"]);
        if result[0] == 0 {
            return result[1];
        }
        return "";
    }

    implement Self::zig {
        function set_output(compiler: self, output: String) -> Compiler {
            compiler.output = output;
            return compiler;
        }

        function setflag(compiler: self, flag: String) -> Compiler {
            compiler.flags.push(flag);
            return compiler;
        }

        function optimize(compiler: self, level: String) -> Compiler {
            if level == "ReleaseFast" || level == "ReleaseSafe" || level == "ReleaseSmall" || level == "Debug" {
                compiler.flags.push("-O");
                compiler.flags.push(level);
            } else {
                log::error("Zig optimization mode must be Debug, ReleaseSafe, ReleaseFast, or ReleaseSmall.");
                roller::exit(4);
            }
            compiler.optimize = level;
            return compiler;
        }

        function outputs(compiler: self) -> Vec<String> {
            return compiler.objects;
        }

        paralleable function compile(compiler: self, file: String) {
            if !compiler.zig_available {
                log::error("Zig is not available. Install Zig or select another compiler.");
                roller::exit(5);
            }
            if sys::path::extension(file) != "zig" {
                return compiler;
            }

            let relative_output = sys::path::replace_extension(file, "o");
            let output = sys::path::join(".roller/build", relative_output);
            sys::fs::mkdir_parent(output);

            let args = ["build-obj"];
            let flags = compiler.flags.copy();
            args.push_vec(flags);
            args.push(file);
            args.push(sys::str::concat("-femit-bin=", output));
            let result = sys::process::output(compiler.file_location, args);
            if result[0] == 0 {
                compiler.objects.push(output);
            } else {
                log::error(result[2]);
                compiler.failure = true;
                roller::exit(5);
            }
        }

        function link(compiler: self, outputs: Vec<String>, output: String) {
            if compiler.failure {
                log::error("Compilation failed; linking was skipped.");
                roller::exit(5);
            }
            if outputs.is_empty() {
                log::error("Cannot link an empty object-file list.");
                roller::exit(5);
            }

            compiler.output = output;
            let args = ["build-exe"];
            args.push_vec(outputs);
            args.push(sys::str::concat("-femit-bin=", output));

            let result = sys::process::output(compiler.file_location, args);
            if result[0] != 0 {
                log::error(result[2]);
                roller::exit(5);
            }
            log::info(sys::str::concat("LINK ", output));
        }
    }
}
